---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import { navigation } from '../../config/navigation';
import logo from '../../assets/logo-horizontal-white.png';
import aboSeal from '../../assets/badges/abo-seal.jpg';
import aaoLogo from '../../assets/badges/aao-logo.svg';
import oddsLogo from '../../assets/badges/odds-logo.png';
import chamberLogo from '../../assets/badges/gretna-chamber.png';
import acpaLogo from '../../assets/badges/acpa-logo.png';
import {
  site,
  formattedAddress,
  formattedPhone,
  directionsHref,
  clinicHours,
  phoneHoursNote,
} from '../../config/site';
import { Icon } from 'astro-icon/components';

const socialIcons: Record<string, string> = {
  facebook: 'lucide:facebook',
  instagram: 'lucide:instagram',
  linkedin: 'lucide:linkedin',
  x: 'lucide:twitter',
  youtube: 'lucide:youtube',
  tiktok: 'lucide:music',
};

const socials = Object.entries(site.social).filter(([, href]) => Boolean(href)) as [
  string,
  string,
][];
const year = new Date().getFullYear();

const organizations = [
  {
    name: 'American Board of Orthodontics',
    href: 'https://www.americanboardortho.com/',
    image: aboSeal,
    widths: [250, 375],
  },
  {
    name: 'American Association of Orthodontists',
    href: 'https://www2.aaoinfo.org/',
    image: aaoLogo,
    widths: [188],
  },
  {
    name: 'Omaha District Dental Society',
    href: 'https://www.omahadistrictds.com/',
    image: oddsLogo,
    widths: [250, 517],
  },
  {
    name: 'Gretna Chamber of Commerce',
    href: 'https://www.gretnachamber.com/',
    image: chamberLogo,
    widths: [225],
  },
  {
    name: 'American Cleft Palate Craniofacial Association',
    href: 'https://acpacares.org/',
    image: acpaLogo,
    widths: [250, 500],
  },
];
---

<Section as="footer" background="inverse" spacing="md">
  <Container gap="lg">
    <div class="grid w-full gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-3 md:col-span-2">
        <a href="/" class="inline-flex w-fit no-underline">
          <Image src={logo} alt={site.name} width={480} class="h-16 w-auto" />
        </a>
        <p class="max-w-reading text-neutral-300">
          With precision and care, we craft smiles that radiate confidence—supporting our patients’
          success at every stage of life.
        </p>

        <address class="mt-2 flex flex-col gap-2 text-neutral-300 not-italic">
          <a
            href={`tel:${site.business.phoneHref}`}
            class="text-ink-inverse inline-flex min-h-11 items-center gap-2 no-underline"
          >
            <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
            {formattedPhone}
          </a>
          <a
            href={`mailto:${site.business.email}`}
            class="text-ink-inverse inline-flex min-h-11 items-center gap-2 no-underline"
          >
            <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
            {site.business.email}
          </a>
          <a
            href={directionsHref}
            rel="noopener noreferrer"
            target="_blank"
            class="text-ink-inverse inline-flex min-h-11 items-start gap-2 no-underline"
          >
            <Icon name="lucide:map-pin" class="mt-1 size-4 shrink-0" aria-hidden="true" />
            {formattedAddress}
          </a>
        </address>

        <dl class="mt-2 text-neutral-300">
          <dt class="text-sm font-semibold tracking-wide text-neutral-400 uppercase">
            Office hours
          </dt>
          {clinicHours.map((line) => <dd>{line}</dd>)}
          <dt class="mt-3 text-sm font-semibold tracking-wide text-neutral-400 uppercase">Phone</dt>
          <dd>{phoneHoursNote}</dd>
        </dl>
      </div>

      {
        navigation.footer.map((group) => (
          <nav aria-label={group.heading} class="flex flex-col gap-3">
            <h2 class="text-sm font-semibold tracking-wide text-neutral-400 uppercase">
              {group.heading}
            </h2>
            <ul class="flex flex-col gap-1">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                    rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="hover:text-ink-inverse inline-flex min-h-11 items-center text-neutral-300 no-underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="flex w-full flex-col gap-4 border-t border-neutral-800 pt-6">
      <h2 class="text-sm font-semibold tracking-wide text-neutral-400 uppercase">Organizations</h2>
      <ul class="flex flex-wrap items-center gap-3">
        <li>
          <a
            href="https://www.bbb.org/us/ne/gretna/profile/orthodontist/platte-river-orthodontics-0714-1000075181/#sealclick"
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="flex size-[125px] items-center justify-center rounded-md bg-white p-2"
          >
            <img
              src="https://seal-nebraska.bbb.org/seals/blue-seal-200-42-bbb-1000075181.png"
              alt="Platte River Orthodontics BBB Business Review"
              width="200"
              height="42"
              class="h-auto max-h-full w-auto max-w-full border-0 object-contain"
            />
          </a>
        </li>
        {
          organizations.map((org) => (
            <li>
              <a
                href={org.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex size-[125px] items-center justify-center rounded-md bg-white p-2"
              >
                <Image
                  src={org.image}
                  alt={org.name}
                  widths={org.widths}
                  sizes="125px"
                  quality={90}
                  class="h-auto max-h-full w-auto max-w-full object-contain"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      socials.length > 0 && (
        <ul class="flex gap-2">
          {socials.map(([platform, href]) => (
            <li>
              <a
                href={href}
                rel="noopener noreferrer"
                target="_blank"
                class="hover:text-ink-inverse inline-flex size-11 items-center justify-center rounded-md text-neutral-300 no-underline hover:bg-neutral-800"
              >
                <span class="sr-only">{platform}</span>
                <Icon
                  name={socialIcons[platform] ?? 'lucide:link'}
                  class="size-5"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div
      class="flex w-full flex-col gap-3 border-t border-neutral-800 pt-6 text-sm text-neutral-400 md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} {site.legalName ?? site.name}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-4">
        {
          navigation.legal.map((link) => (
            <li>
              <a href={link.href} class="hover:text-ink-inverse text-neutral-400 no-underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>
