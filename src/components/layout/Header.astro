---
/**
 * Owns its outer element rather than wrapping in Section: sticky behaviour
 * needs its own positioning and stacking context. Container is used inside.
 *
 * On overlay pages the bar sits transparent over the hero, then switches to a
 * white background once it sticks. MegaMenu (md+) and MobileNav (below md)
 * both read src/config/navigation.ts.
 */
import Container from '../ui/Container.astro';
import MegaMenu from './MegaMenu.astro';
import MobileNav from './MobileNav.astro';
import { navigation } from '../../config/navigation';
import { site } from '../../config/site';
import { Icon } from 'astro-icon/components';

export type HeaderSticky = 'static' | 'sticky' | 'shrink' | 'hide-on-scroll';

interface Props {
  sticky?: HeaderSticky;
  /** Transparent over a hero until the bar sticks, then white. */
  overlay?: boolean;
}

const { sticky = 'sticky', overlay = false } = Astro.props;

const currentPath = Astro.url.pathname;
const positioned = sticky !== 'static';
const portal = navigation.portal?.href ? navigation.portal : undefined;
---

<header
  data-sticky={sticky}
  data-overlay={overlay ? 'true' : 'false'}
  data-appearance={overlay ? 'overlay' : 'solid'}
  class:list={[
    'group/header z-50 w-full transition-colors duration-200',
    // The mega panel is absolutely positioned against the header, so the header
    // must be a positioned ancestor even when it isn't sticky.
    positioned ? 'sticky top-0' : 'relative',
  ]}
>
  <Container
    as="div"
    layout="bar"
    gap="none"
    class="justify-between gap-4 py-4 group-data-[scrolled=true]/header:py-2"
  >
    <a
      href="/"
      class="flex items-center gap-2 font-semibold tracking-wide uppercase no-underline group-data-[appearance=overlay]/header:text-ink-inverse group-data-[appearance=solid]/header:text-ink-base"
    >
      <Icon name="lucide:hexagon" class="size-7" aria-hidden="true" />
      <span class="max-lg:text-sm">{site.name}</span>
    </a>

    <div class="flex items-center gap-2 lg:gap-3">
      <MegaMenu currentPath={currentPath} />

      {
        portal && (
          <a
            href={portal.href}
            class="hidden min-h-11 items-center px-2 text-sm no-underline xl:inline-flex group-data-[appearance=overlay]/header:text-ink-inverse group-data-[appearance=solid]/header:text-ink-base"
          >
            {portal.label}
          </a>
        )
      }

      {
        navigation.cta && (
          <a
            href={navigation.cta.href}
            class:list={[
              'hidden min-h-11 items-center rounded-full border px-5 text-xs font-semibold tracking-wide uppercase no-underline md:inline-flex',
              'group-data-[appearance=overlay]/header:border-white/70 group-data-[appearance=overlay]/header:bg-white/10 group-data-[appearance=overlay]/header:text-ink-inverse group-data-[appearance=overlay]/header:hover:bg-white/20',
              'group-data-[appearance=solid]/header:border-brand-600 group-data-[appearance=solid]/header:bg-brand-600 group-data-[appearance=solid]/header:text-neutral-0 group-data-[appearance=solid]/header:hover:bg-brand-700',
            ]}
          >
            {navigation.cta.label}
          </a>
        )
      }

      <MobileNav currentPath={currentPath} />
    </div>
  </Container>
</header>

<style>
  header {
    transition:
      transform 200ms ease,
      padding 150ms ease,
      background-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease;
  }

  header[data-appearance='overlay'] {
    background-color: transparent;
    color: var(--color-ink-inverse);
  }

  header[data-appearance='solid'] {
    background-color: var(--color-surface-base);
    color: var(--color-ink-base);
    box-shadow: var(--shadow-sm);
  }

  header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    header {
      transition: none;
    }

    header[data-hidden='true'] {
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('header[data-sticky]');

  if (header) {
    const mode = header.dataset.sticky;
    const overlay = header.dataset.overlay === 'true';
    const topBar = document.querySelector<HTMLElement>('[data-topbar]');
    let lastY = window.scrollY;
    let ticking = false;

    const setVars = () => {
      document.documentElement.style.setProperty('--nav-h', `${header.offsetHeight}px`);
      if (topBar) {
        document.documentElement.style.setProperty('--topbar-h', `${topBar.offsetHeight}px`);
      }
    };

    const update = () => {
      const y = window.scrollY;
      const topBarGone = !topBar || topBar.getBoundingClientRect().bottom <= 0;

      header.dataset.scrolled = String(y > 8 || topBarGone);

      if (overlay && mode !== 'static') {
        header.dataset.appearance = topBarGone ? 'solid' : 'overlay';
      }

      if (mode === 'hide-on-scroll') {
        const navOpen =
          document.querySelector('#nav-toggle')?.getAttribute('aria-expanded') === 'true' ||
          document.querySelector('.mega-item[data-open="true"]') !== null;
        header.dataset.hidden = String(!navOpen && y > lastY && y > 120);
      }

      lastY = y;
      ticking = false;
      setVars();
    };

    if (mode !== 'static') {
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );

      update();
    }

    setVars();
    window.addEventListener('resize', setVars, { passive: true });
  }
</script>
