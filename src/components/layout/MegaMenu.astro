---
/**
 * Desktop navigation (xl and up). Below 1280 the labels overflow the bar.
 *
 * Uses the disclosure pattern — a button with aria-expanded/aria-controls per
 * panel — not role="menubar". Menubar is the ARIA application pattern and puts
 * screen readers into application mode, which breaks normal page browsing.
 *
 * Open/close intent delay is CSS transition-delay so the no-JS baseline keeps
 * it. JS layers keyboard control, Escape, outside click, and touch toggling.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { navigation, type MegaPanel, type NavLink } from '../../config/navigation';
import { clinicHours, directionsHref, formattedPhone, phoneHoursNote, site } from '../../config/site';
import officeExterior from '../../assets/office-exterior.jpg';
import treatmentRoom from '../../assets/live/platte-river-ortho-treatment-chair.jpg';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const triggerClass =
  'relative inline-flex min-h-11 items-center gap-1 rounded-md px-2 text-base font-medium whitespace-nowrap no-underline transition-colors group-data-[appearance=solid]/header:text-ink-base group-data-[appearance=solid]/header:hover:bg-neutral-100 group-data-[appearance=solid]/header:aria-[current=page]:text-ink-brand group-data-[appearance=overlay]/header:text-ink-inverse group-data-[appearance=overlay]/header:hover:bg-white/10 group-data-[appearance=overlay]/header:aria-[current=page]:bg-white/10 group-data-[appearance=overlay]/header:aria-[current=page]:text-ink-inverse';

const eyebrowClass = 'text-ink-muted text-xs font-semibold tracking-wide uppercase';

const textCtaClass =
  'text-ink-brand inline-flex shrink-0 items-center gap-2 border-b border-accent-500 pb-1 text-xs font-semibold tracking-wide uppercase no-underline';

const gridClass = (panel: MegaPanel) =>
  panel.variant === 'treatments'
    ? 'grid w-full items-start gap-8 xl:grid-cols-[minmax(0,1fr)_20rem]'
    : 'grid w-full items-start gap-8 xl:grid-cols-[16rem_minmax(0,1fr)_minmax(0,1fr)_18.75rem]';
---

<nav aria-label="Primary" class="mega hidden xl:block">
  <ul class="flex items-center gap-1">
    {
      navigation.primary.map((item, index) => {
        const panelId = `mega-panel-${index}`;

        if (!item.panel || item.panel.kind !== 'mega') {
          return (
            <li>
              <a
                href={item.href ?? '#'}
                aria-current={isCurrent(item.href ?? '') ? 'page' : undefined}
                class={triggerClass}
              >
                {item.label}
              </a>
            </li>
          );
        }

        const panel = item.panel;

        return (
          <li class="mega-item static">
            <button
              type="button"
              aria-expanded="false"
              aria-controls={panelId}
              class={triggerClass}
            >
              {item.label}
              <Icon name="lucide:chevron-down" class="mega-chevron size-4" aria-hidden="true" />
            </button>

            <div
              id={panelId}
              class="mega-panel border-line-base bg-surface-base absolute inset-x-0 top-full flex flex-col border-b shadow-lg"
            >
              <Container gap="none" class="max-h-[70vh] overflow-y-auto py-10">
                <div class={gridClass(panel)}>
                  {panel.intro && (
                    <div class="flex min-w-0 flex-col gap-4 pr-2">
                      <p class={eyebrowClass}>{panel.intro.eyebrow}</p>
                      <p class="font-heading text-ink-base text-2xl leading-tight">
                        {panel.intro.title}
                        {panel.intro.titleAccent && (
                          <span class="text-accent-500 mt-1 block">{panel.intro.titleAccent}</span>
                        )}
                      </p>
                      <span class="bg-accent-500 block h-px w-11" aria-hidden="true" />
                      <p class="text-ink-muted text-sm leading-normal">{panel.intro.body}</p>
                    </div>
                  )}

                  {panel.columns.map((column) => (
                    <div class="flex min-w-0 flex-col gap-3">
                      {column.heading && <p class={eyebrowClass}>{column.heading}</p>}
                      <ul class="flex flex-col">
                        {column.links.map((link: NavLink) => (
                          <li>
                            <a
                              href={link.href}
                              aria-current={isCurrent(link.href) ? 'page' : undefined}
                              class="group/entry border-line-base flex flex-col gap-2 border-t py-4 no-underline"
                            >
                              <span class="flex items-start gap-2">
                                <span class="font-heading text-ink-base group-hover/entry:text-ink-brand min-w-0 flex-1 text-lg leading-snug">
                                  {link.label}
                                </span>
                                <Icon
                                  name="lucide:arrow-up-right"
                                  class="text-ink-brand mt-1 size-4 shrink-0"
                                  aria-hidden="true"
                                />
                              </span>
                              {link.description && (
                                <span class="text-ink-muted text-sm leading-normal">
                                  {link.description}
                                </span>
                              )}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}

                  {panel.feature?.kind === 'office' && (
                    <div class="flex min-w-0 flex-col gap-3">
                      <Image
                        src={officeExterior}
                        alt="Entrance to Platte River Orthodontics at 11844 Standing Stone Drive"
                        widths={[320, 480, 640]}
                        sizes="300px"
                        class="h-40 w-full object-cover"
                      />
                      <p class={eyebrowClass}>{panel.feature.eyebrow}</p>
                      <a
                        href={directionsHref}
                        rel="noopener noreferrer"
                        target="_blank"
                        class="text-ink-base text-sm leading-normal no-underline"
                      >
                        {site.business.address.street}
                        <br />
                        {site.business.address.locality}, {site.business.address.region}{' '}
                        {site.business.address.postalCode}
                      </a>
                      <a
                        href={`tel:${site.business.phoneHref}`}
                        class="text-ink-brand text-sm font-semibold no-underline"
                      >
                        {formattedPhone}
                      </a>
                      <div class="border-line-base flex flex-col gap-1 border-t pt-3 text-sm leading-normal">
                        {clinicHours.map((line) => (
                          <p class={line.includes('Closed') ? 'text-neutral-400' : 'text-ink-muted'}>{line}</p>
                        ))}
                        <p class="text-ink-muted mt-2">{phoneHoursNote}</p>
                      </div>
                    </div>
                  )}

                  {panel.feature?.kind === 'card' && (
                    <div class="bg-surface-muted flex min-w-0 flex-col items-start gap-4 p-6">
                      <p class={eyebrowClass}>{panel.feature.eyebrow}</p>
                      <span class="bg-accent-500 block h-px w-11" aria-hidden="true" />
                      <p class="font-heading text-ink-base text-xl leading-tight">
                        {panel.feature.title}
                      </p>
                      <p class="text-ink-muted text-sm leading-normal">{panel.feature.body}</p>
                      <Button href={panel.feature.href} size="sm">
                        {panel.feature.cta}
                        <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
                      </Button>
                      {panel.feature.note && (
                        <p class="text-ink-muted text-xs">{panel.feature.note}</p>
                      )}
                    </div>
                  )}

                  {panel.feature?.kind === 'media' && (
                    <div class="flex min-w-0 flex-col gap-4">
                      <Image
                        src={treatmentRoom}
                        alt="Treatment chair in a Platte River Orthodontics operatory"
                        widths={[320, 480, 640]}
                        sizes="300px"
                        class="h-40 w-full object-cover"
                      />
                      <p class="font-heading text-ink-base text-xl leading-tight">
                        {panel.feature.title}
                      </p>
                      <p class="text-ink-muted text-sm leading-normal">{panel.feature.body}</p>
                      <a href={panel.feature.href} class={textCtaClass}>
                        {panel.feature.cta}
                        <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
                      </a>
                    </div>
                  )}
                </div>
              </Container>

              {panel.support && (
                <div class="border-line-base bg-surface-muted border-t">
                  <Container layout="bar" gap="none" class="justify-between gap-6 py-5">
                    <p class="text-ink-muted min-w-0 text-sm">{panel.support.text}</p>
                    <a href={panel.support.href} class={textCtaClass}>
                      {panel.support.cta}
                      <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
                    </a>
                  </Container>
                </div>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .mega-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.25rem);
    /* Closing lingers ~260ms so diagonal travel into the panel survives. */
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 0s linear 260ms;
  }

  .mega-chevron {
    transition: transform 160ms ease;
  }

  .mega-item > button::after {
    content: '';
    position: absolute;
    right: 0.5rem;
    bottom: 0.2rem;
    left: 0.5rem;
    height: 3px;
    background: var(--color-brand-600);
    opacity: 0;
  }

  /* Hover intent only where hovering is real — a touch tablet would otherwise
     open and immediately close the panel on first tap. */
  @media (hover: hover) {
    .mega-item:hover > .mega-panel {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 120ms, 120ms, 0s;
    }

    .mega-item:hover > button > .mega-chevron {
      transform: rotate(180deg);
    }

    .mega-item:hover > button::after {
      opacity: 1;
    }

    :global(header[data-appearance='solid']) .mega-item:hover > button {
      color: var(--color-ink-brand);
    }
  }

  :global(header[data-appearance='solid']) .mega-item[data-open='true'] > button {
    color: var(--color-ink-brand);
  }

  /* No-JS baseline: keyboard focus alone opens the panel. Disabled once JS is
     present, otherwise returning focus to the trigger on Escape would reopen it. */
  :global(html:not(.js)) .mega-item:focus-within > .mega-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  :global(html:not(.js)) .mega-item:focus-within > button::after {
    opacity: 1;
  }

  .mega-item[data-open='true'] > .mega-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  .mega-item[data-open='true'] > button > .mega-chevron {
    transform: rotate(180deg);
  }

  .mega-item[data-open='true'] > button::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-panel,
    .mega-chevron {
      transition-duration: 0s;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('nav.mega');

  if (nav) {
    const items = Array.from(nav.querySelectorAll<HTMLLIElement>('.mega-item'));
    const canHover = window.matchMedia('(hover: hover)').matches;
    let closeTimer: number | undefined;

    const setOpen = (item: HTMLLIElement, open: boolean) => {
      item.dataset.open = String(open);
      item.querySelector('button')?.setAttribute('aria-expanded', String(open));
    };

    // Only one panel open at a time.
    const closeAll = (except?: HTMLLIElement) => {
      for (const item of items) if (item !== except) setOpen(item, false);
    };

    for (const item of items) {
      const trigger = item.querySelector<HTMLButtonElement>('button');
      if (!trigger) continue;

      trigger.addEventListener('click', () => {
        const open = item.dataset.open === 'true';
        closeAll(item);
        setOpen(item, !open);
      });

      if (canHover) {
        item.addEventListener('mouseenter', () => {
          window.clearTimeout(closeTimer);
          closeAll(item);
          setOpen(item, true);
        });

        item.addEventListener('mouseleave', () => {
          window.clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => setOpen(item, false), 260);
        });
      }

      // Tabbing out of the panel closes it; Escape returns focus to the trigger.
      item.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (!next || !item.contains(next)) setOpen(item, false);
      });

      item.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && item.dataset.open === 'true') {
          setOpen(item, false);
          trigger.focus();
        }
      });
    }

    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) closeAll();
    });
  }
</script>
