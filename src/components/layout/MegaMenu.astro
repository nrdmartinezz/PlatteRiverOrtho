---
/**
 * Desktop and tablet navigation (md and up).
 *
 * Uses the disclosure pattern — a button with aria-expanded/aria-controls per
 * panel — not role="menubar". Menubar is the ARIA application pattern and puts
 * screen readers into application mode, which breaks normal page browsing.
 *
 * Open/close intent delay is CSS transition-delay so the no-JS baseline keeps
 * it. JS layers keyboard control, Escape, outside click, and touch toggling.
 */
import { navigation } from '../../config/navigation';
import { Icon } from 'astro-icon/components';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const triggerClass =
  'inline-flex min-h-11 items-center gap-1 rounded-md px-2 text-sm font-medium no-underline transition-colors lg:px-3 lg:text-base group-data-[appearance=solid]/header:text-ink-base group-data-[appearance=solid]/header:hover:bg-neutral-100 group-data-[appearance=solid]/header:aria-[current=page]:text-ink-brand group-data-[appearance=overlay]/header:text-ink-inverse group-data-[appearance=overlay]/header:hover:bg-white/10 group-data-[appearance=overlay]/header:aria-[current=page]:bg-white/10 group-data-[appearance=overlay]/header:aria-[current=page]:text-ink-inverse';

const linkClass =
  'text-ink-brand aria-[current=page]:bg-neutral-100 flex min-h-11 items-center gap-3 rounded-md px-3 py-2 font-medium no-underline hover:bg-neutral-100';
---

<nav aria-label="Primary" class="mega hidden md:block">
  <ul class="flex items-center gap-1">
    {
      navigation.primary.map((item, index) => {
        const panelId = `mega-panel-${index}`;

        if (!item.panel) {
          return (
            <li>
              <a
                href={item.href ?? '#'}
                aria-current={isCurrent(item.href ?? '') ? 'page' : undefined}
                class={triggerClass}
              >
                {item.label}
              </a>
            </li>
          );
        }

        const isMega = item.panel.kind === 'mega';
        const groups = isMega ? item.panel.columns : item.panel.groups;
        const featured = isMega ? item.panel.featured : undefined;

        return (
          <li class:list={['mega-item', isMega ? 'static' : 'relative']}>
            <button
              type="button"
              aria-expanded="false"
              aria-controls={panelId}
              class={triggerClass}
            >
              {item.label}
              <Icon name="lucide:chevron-down" class="mega-chevron size-4" aria-hidden="true" />
            </button>

            <div
              id={panelId}
              class:list={[
                'mega-panel border-line-base bg-surface-base absolute shadow-lg',
                isMega
                  ? 'inset-x-0 top-full border-b'
                  : index === 0
                    ? 'top-full left-0 z-20 mt-2 w-max min-w-72 max-w-sm rounded-xl border'
                    : 'top-full right-0 z-20 mt-2 w-max min-w-72 max-w-sm rounded-xl border',
              ]}
            >
              <div
                class:list={[
                  isMega
                    ? 'px-gutter mx-auto max-h-[70vh] w-full max-w-page overflow-y-auto py-8'
                    : 'p-5',
                ]}
              >
                <div
                  class:list={[
                    isMega
                      ? 'grid w-full grid-cols-2 gap-x-10 gap-y-8 lg:grid-cols-3'
                      : 'flex flex-col gap-5',
                  ]}
                >
                  {groups.map((column) => (
                    <div class="flex flex-col gap-1">
                      {column.heading && (
                        <h2 class="text-ink-brand px-3 pb-1 text-sm font-semibold">
                          {column.heading}
                        </h2>
                      )}
                      <ul class="flex flex-col">
                        {column.links.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              aria-current={isCurrent(link.href) ? 'page' : undefined}
                              target={link.href.startsWith('http') ? '_blank' : undefined}
                              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                              class={linkClass}
                            >
                              {link.icon && (
                                <Icon
                                  name={link.icon}
                                  class="text-brand-600 size-5 shrink-0"
                                  aria-hidden="true"
                                />
                              )}
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>

                {featured && (
                  <div class="border-line-base mt-8 flex flex-col items-start justify-between gap-4 border-t pt-5 sm:flex-row sm:items-center">
                    <p class="text-ink-brand">
                      <span class="font-semibold">{featured.title}</span> {featured.body}
                    </p>
                    <a
                      href={featured.href}
                      class="border-accent-500 bg-accent-500 text-neutral-0 hover:bg-accent-600 inline-flex min-h-11 shrink-0 items-center rounded-full border px-5 text-xs font-semibold tracking-wide uppercase no-underline"
                    >
                      {featured.cta}
                    </a>
                  </div>
                )}
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .mega-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.25rem);
    /* Closing lingers ~260ms so diagonal travel into the panel survives. */
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 0s linear 260ms;
  }

  .mega-chevron {
    transition: transform 160ms ease;
  }

  /* Hover intent only where hovering is real — a touch tablet would otherwise
     open and immediately close the panel on first tap. */
  @media (hover: hover) {
    .mega-item:hover > .mega-panel {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 120ms, 120ms, 0s;
    }

    .mega-item:hover > button > .mega-chevron {
      transform: rotate(180deg);
    }
  }

  /* No-JS baseline: keyboard focus alone opens the panel. Disabled once JS is
     present, otherwise returning focus to the trigger on Escape would reopen it. */
  :global(html:not(.js)) .mega-item:focus-within > .mega-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  .mega-item[data-open='true'] > .mega-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  .mega-item[data-open='true'] > button > .mega-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-panel,
    .mega-chevron {
      transition-duration: 0s;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('nav.mega');

  if (nav) {
    const items = Array.from(nav.querySelectorAll<HTMLLIElement>('.mega-item'));
    const canHover = window.matchMedia('(hover: hover)').matches;
    let closeTimer: number | undefined;

    const setOpen = (item: HTMLLIElement, open: boolean) => {
      item.dataset.open = String(open);
      item.querySelector('button')?.setAttribute('aria-expanded', String(open));
    };

    // Only one panel open at a time.
    const closeAll = (except?: HTMLLIElement) => {
      for (const item of items) if (item !== except) setOpen(item, false);
    };

    for (const item of items) {
      const trigger = item.querySelector<HTMLButtonElement>('button');
      if (!trigger) continue;

      trigger.addEventListener('click', () => {
        const open = item.dataset.open === 'true';
        closeAll(item);
        setOpen(item, !open);
      });

      if (canHover) {
        item.addEventListener('mouseenter', () => {
          window.clearTimeout(closeTimer);
          closeAll(item);
          setOpen(item, true);
        });

        item.addEventListener('mouseleave', () => {
          window.clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => setOpen(item, false), 260);
        });
      }

      // Tabbing out of the panel closes it; Escape returns focus to the trigger.
      item.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (!next || !item.contains(next)) setOpen(item, false);
      });

      item.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && item.dataset.open === 'true') {
          setOpen(item, false);
          trigger.focus();
        }
      });
    }

    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) closeAll();
    });
  }
</script>
