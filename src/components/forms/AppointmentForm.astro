---
import Field from '../ui/Field.astro';
import FormMessage from '../ui/FormMessage.astro';
import Button from '../ui/Button.astro';
import Heading from '../ui/Heading.astro';
import { site, phoneHoursNote } from '../../config/site';

const action = site.formEndpoint || '';
const thankYou = new URL('/thank-you/', site.url).href;

const treatments = [
  'Invisalign',
  'Braces',
  'Early treatment',
  'Surgical orthodontics',
  'Retainers',
  'Teeth whitening',
  'Airway-aware treatment',
  'MARPE',
  'Not sure yet',
];
---

<div class="bg-surface-muted flex flex-col gap-6 rounded-2xl p-8 md:p-10">
  <Heading level={2} size="md" class="text-ink-brand">Request a Consultation</Heading>
  <p class="text-ink-muted">
    Share your name, phone, email, and request. We email and text within one business day.
    {phoneHoursNote}. To choose a time yourself, use the scheduler below.
  </p>

  <form
    id="appointment-form"
    action={action}
    method="POST"
    novalidate
    class="flex w-full flex-col gap-4"
    data-site-form
    data-thank-you={thankYou}
    data-track-source="appointment-form"
  >
    <input type="hidden" name="form_type" value="appointment" />

    <div class="absolute left-[-9999px]" aria-hidden="true">
      <label for="appointment-gotcha">Leave this field empty</label>
      <input type="text" id="appointment-gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <Field name="name" label="First and last name" autocomplete="name" required />

    <div class="grid gap-4 sm:grid-cols-2">
      <Field name="email" label="Email" type="email" autocomplete="email" required />
      <Field name="phone" label="Phone" type="tel" autocomplete="tel" required />
    </div>

    <Field name="message" label="Request" type="textarea" rows={4} required />

    <Field
      name="service"
      label="Treatment interest"
      type="select"
      help="Optional."
      options={[
        { label: 'Select a treatment', value: '' },
        ...treatments.map((treatment) => ({ label: treatment, value: treatment })),
      ]}
    />

    <Field
      name="concerns"
      label="Additional concerns"
      type="textarea"
      rows={3}
      help="Optional."
    />

    <label class="text-ink-muted flex items-start gap-3 text-sm">
      <input
        type="checkbox"
        name="sms_consent"
        value="yes"
        class="border-line-base mt-1 size-4 rounded"
      />
      <span>
        By sharing your phone number, you consent to receive communications from Platte River
        Orthodontics, including notifications and appointment reminders. Message and data rates may
        apply. Text STOP to unsubscribe.
      </span>
    </label>

    <FormMessage />
    <Button type="submit" size="lg" class="w-full">Send request</Button>
  </form>
</div>
