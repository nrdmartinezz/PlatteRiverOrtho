---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps, BlockAction } from './types';

interface Props extends BlockProps {
  actions: BlockAction[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  background = 'brand',
  spacing = 'md',
  align = 'center',
  width = 'narrow',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  actions,
  image,
  imageAlt = '',
} = Astro.props;

const defaultVariant = background === 'brand' || background === 'inverse' || image ? 'inverse' : 'primary';
---

<Section
  background={image ? 'inverse' : background}
  spacing={spacing}
  class:list={[image && 'relative isolate overflow-hidden']}
>
  {
    image && (
      <div class="absolute inset-0 -z-10">
        <Image
          src={image}
          alt={imageAlt}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          class="size-full object-cover"
        />
        <div class="absolute inset-0 bg-linear-to-br from-brand-100/95 via-brand-500/90 to-accent-400/85" />
      </div>
    )
  }

  <Container width={width} align={align} gap="md" class:list={[image && 'relative z-10']}>
    {eyebrow && <p class="text-sm font-semibold tracking-wide uppercase opacity-80">{eyebrow}</p>}
    {
      title && (
        <Heading
          level={titleLevel}
          class:list={[(background === 'brand' || background === 'inverse' || image) && 'text-ink-inverse']}
        >
          {title}
        </Heading>
      )
    }
    {body && <p class="max-w-reading text-lg opacity-90">{body}</p>}

    <div class:list={['flex flex-wrap gap-3', align === 'center' && 'justify-center']}>
      {
        actions.map((action) => {
          const onDark = background === 'brand' || background === 'inverse' || Boolean(image);
          const variant = action.variant ?? defaultVariant;
          return (
            <Button
              href={action.href}
              variant={onDark && variant === 'secondary' ? 'ghost' : variant}
              size="lg"
              class:list={[
                onDark &&
                  variant === 'secondary' &&
                  'border-white/80 text-ink-inverse hover:bg-white/10',
              ]}
            >
              {action.label}
              {action.href.startsWith('tel:') ? (
                <Icon name="lucide:phone" class="size-3.5" aria-hidden="true" />
              ) : (
                <Icon name="lucide:arrow-right" class="size-3.5" aria-hidden="true" />
              )}
            </Button>
          );
        })
      }
    </div>
  </Container>
</Section>
