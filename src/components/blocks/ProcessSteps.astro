---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import BlockHeader from './BlockHeader.astro';
import { Icon } from 'astro-icon/components';
import type { BlockAction, BlockProps } from './types';

export interface ProcessStep {
  title: string;
  body: string;
  icon?: string;
}

interface Props extends BlockProps {
  items: ProcessStep[];
  /** Numbers the steps rather than showing icons. */
  numbered?: boolean;
  /** Optional call to action under the steps. */
  action?: BlockAction;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  items,
  numbered = true,
  action,
} = Astro.props;

const onBrand = background === 'brand' || background === 'inverse';
---

<Section background={background} spacing={spacing}>
  <Container width={width} align={align} gap="lg">
    <BlockHeader
      eyebrow={eyebrow}
      title={title}
      body={body}
      level={titleLevel}
      centered={align === 'center'}
      inverse={onBrand}
    />

    <ol
      class:list={[
        'grid w-full gap-8',
        items.length === 3 && 'sm:grid-cols-3',
        items.length === 4 && 'sm:grid-cols-2',
        items.length > 4 && 'sm:grid-cols-2 lg:grid-cols-4',
      ]}
    >
      {
        items.map((step, index) => (
          <li
            class:list={[
              'relative flex flex-col gap-3',
              align === 'center' && 'items-center text-center',
            ]}
          >
            {
              onBrand && index < items.length - 1 && (
                <span
                  class="absolute top-8 left-[calc(50%+2.25rem)] hidden h-px w-[calc(100%-2.5rem)] bg-white/20 lg:block"
                  aria-hidden="true"
                />
              )
            }
            <span
              class:list={[
                'flex size-16 items-center justify-center rounded-full border-2 font-heading text-2xl font-bold',
                onBrand
                  ? 'border-white/20 bg-white/10 text-accent-200'
                  : 'border-brand-600 text-ink-brand',
              ]}
              aria-hidden="true"
            >
              {numbered || !step.icon ? (
                String(index + 1).padStart(2, '0')
              ) : (
                <Icon name={step.icon} class="size-5" />
              )}
            </span>
            <Heading level={titleLevel === 2 ? 3 : 4} size="md" class={onBrand ? 'text-ink-inverse' : undefined}>
              {step.title}
            </Heading>
            <p class={onBrand ? 'text-sm text-white/75' : 'text-ink-muted'}>{step.body}</p>
          </li>
        ))
      }
    </ol>

    {
      action && (
        <div class:list={['flex w-full', align === 'center' && 'justify-center']}>
          <Button href={action.href} variant={action.variant ?? 'accent'}>
            {action.label}
            <Icon name="lucide:arrow-right" class="size-3.5" aria-hidden="true" />
          </Button>
        </div>
      )
    }
  </Container>
</Section>
