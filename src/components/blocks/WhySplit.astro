---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps } from './types';

interface Props extends BlockProps {
  items: string[];
  asideEyebrow?: string;
  asideTitle?: string;
  asideBody?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  background = 'base',
  spacing = 'md',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  items,
  asideEyebrow,
  asideTitle,
  asideBody,
  image,
  imageAlt = '',
} = Astro.props;
---

<Section background={background} spacing={spacing}>
  <Container width={width} layout="row" gap="lg" class="md:items-start">
    <div class="flex w-full flex-col gap-5 md:w-1/2">
      {
        eyebrow && (
          <p class="text-ink-brand text-sm font-semibold tracking-wide uppercase">{eyebrow}</p>
        )
      }
      {title && <Heading level={titleLevel}>{title}</Heading>}
      {body && <p class="text-ink-muted">{body}</p>}
      <ul class="flex flex-col gap-4">
        {
          items.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="lucide:circle-check" class="text-brand-600 mt-0.5 size-5 shrink-0" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex w-full flex-col gap-5 md:w-1/2">
      {
        asideEyebrow && (
          <p class="text-ink-brand text-sm font-semibold tracking-wide uppercase">{asideEyebrow}</p>
        )
      }
      {asideTitle && <Heading level={3}>{asideTitle}</Heading>}
      {asideBody && <p class="text-ink-muted">{asideBody}</p>}
      {
        image && (
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 768, 1024]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class="mt-2 w-full rounded-2xl object-cover"
          />
        )
      }
    </div>
  </Container>
</Section>
