---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import BlockHeader from './BlockHeader.astro';
import type { BlockProps } from './types';

export interface Stat {
  value: string;
  label: string;
}

interface Props extends BlockProps {
  items: Stat[];
  /** Compact four-across strip used under the homepage hero. */
  compact?: boolean;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  items,
  compact = false,
} = Astro.props;

const columnClass = items.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3';
---

<Section
  background={compact ? 'brand' : background}
  spacing={compact ? 'none' : spacing}
  class={compact ? 'stats-strip' : undefined}
>
  <Container width={width} align={align} gap={compact ? 'none' : 'lg'}>
    {
      !compact && (
        <BlockHeader
          eyebrow={eyebrow}
          title={title}
          body={body}
          level={titleLevel}
          centered={align === 'center'}
        />
      )
    }

    <dl
      class:list={[
        'grid w-full',
        compact ? 'gap-0 divide-white/20 sm:divide-x' : 'gap-8',
        columnClass,
      ]}
    >
      {
        items.map((stat) => (
          <div class:list={['flex flex-col', compact ? 'items-center gap-0.5 px-4 py-3 text-center' : 'gap-1']}>
            <dt
              class:list={[
                'order-2',
                compact
                  ? 'text-xs tracking-wide text-white/75 uppercase'
                  : 'text-ink-muted text-sm',
              ]}
            >
              {stat.label}
            </dt>
            <dd
              class:list={[
                'font-heading order-1 font-bold tracking-tight',
                compact ? 'text-2xl text-white' : 'text-ink-brand text-3xl font-semibold',
              ]}
            >
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </Container>
</Section>

<style>
  .stats-strip {
    background-image: linear-gradient(
      90deg,
      var(--color-brand-300) 0%,
      var(--color-brand-500) 50%,
      var(--color-accent-500) 100%
    );
  }
</style>
