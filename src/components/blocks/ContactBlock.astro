---
/**
 * Contact form block — posts to /api/submit.php via SiteFormHandler.
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Field from '../ui/Field.astro';
import FormMessage from '../ui/FormMessage.astro';
import Button from '../ui/Button.astro';
import Heading from '../ui/Heading.astro';
import { Icon } from 'astro-icon/components';
import { site, formattedAddress } from '../../config/site';
import type { BlockProps } from './types';

interface Props extends BlockProps {
  formTitle?: string;
  services?: string[];
}

const {
  background = 'base',
  spacing = 'md',
  width = 'page',
  eyebrow = 'Get In Touch',
  title = 'Get an Appointment!',
  body = 'Ready to start your smile journey? Fill out the form or reach us directly. We typically respond within one business day.',
  titleLevel = 2,
  formTitle = 'Contact Us — Request Your Appointment!',
  services = [],
} = Astro.props;

const action = site.formEndpoint || '';
const thankYou = new URL('/thank-you/', site.url).href;

const socials = (
  [
    ['facebook', site.social.facebook],
    ['instagram', site.social.instagram],
    ['youtube', site.social.youtube],
  ] as const
).filter(([, href]) => Boolean(href)) as [string, string][];

const socialIcons: Record<string, string> = {
  facebook: 'lucide:facebook',
  instagram: 'lucide:instagram',
  youtube: 'lucide:youtube',
};
---

<Section background={background} spacing={spacing} id="contact">
  <Container width={width}>
    <div class="overflow-hidden rounded-2xl shadow-md md:grid md:grid-cols-2">
      <div class="bg-brand-600 text-ink-inverse flex flex-col gap-6 p-8 md:p-10">
        {
          eyebrow && (
            <p class="text-sm font-semibold tracking-wide uppercase text-white/70">{eyebrow}</p>
          )
        }
        <Heading level={titleLevel} class="text-ink-inverse">
          {title}
        </Heading>
        {body && <p class="text-white/80">{body}</p>}

        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-white/15">
              <Icon name="lucide:map-pin" class="size-4" aria-hidden="true" />
            </span>
            <span>{formattedAddress}</span>
          </li>
          <li>
            <a
              href={`tel:${site.business.phoneHref}`}
              data-source="contact-block"
              class="inline-flex min-h-11 items-center gap-3 no-underline"
            >
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-white/15">
                <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
              </span>
              402-322-8838
            </a>
          </li>
          <li>
            <a
              href={`mailto:${site.business.email}`}
              class="inline-flex min-h-11 items-center gap-3 break-all no-underline"
            >
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-white/15">
                <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
              </span>
              {site.business.email}
            </a>
          </li>
        </ul>

        {
          socials.length > 0 && (
            <div class="mt-auto pt-4">
              <p class="mb-3 text-sm tracking-wide uppercase text-white/70">Follow Us</p>
              <ul class="flex gap-2">
                {socials.map(([platform, href]) => (
                  <li>
                    <a
                      href={href}
                      rel="noopener noreferrer"
                      target="_blank"
                      class="inline-flex size-9 items-center justify-center rounded-full bg-white/15 no-underline hover:bg-white/25"
                    >
                      <span class="sr-only">{platform}</span>
                      <Icon name={socialIcons[platform]} class="size-4" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <div class="bg-surface-muted flex flex-col gap-6 p-8 md:p-10">
        <Heading level={3} size="md" class="text-ink-brand">
          {formTitle}
        </Heading>

        {
          !action && (
            <p class="rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
              No <code>formEndpoint</code> in <code>src/config/site.ts</code> — this form will not
              submit until one is set.
            </p>
          )
        }

        <form
          id="contact-form"
          action={action}
          method="POST"
          novalidate
          class="flex w-full flex-col gap-4"
          data-site-form
          data-thank-you={thankYou}
          data-track-source="contact-form"
        >
          {action && <input type="hidden" name="form_type" value="contact" />}

          <div class="absolute left-[-9999px]" aria-hidden="true">
            <label for="_gotcha">Leave this field empty</label>
            <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <Field name="name" label="First & Last Name" autocomplete="name" required />

          <div class="grid gap-4 sm:grid-cols-2">
            <Field name="email" label="Email" type="email" autocomplete="email" required />
            <Field name="phone" label="Phone" type="tel" autocomplete="tel" />
          </div>

          {
            services.length > 0 && (
              <Field
                name="service"
                label="What do you need?"
                type="select"
                options={[
                  { label: 'Select a service', value: '' },
                  ...services.map((service) => ({ label: service, value: service })),
                ]}
              />
            )
          }

          <Field
            name="message"
            label="Tell us about your orthodontic concerns"
            type="textarea"
            rows={4}
            required
          />

          <label class="text-ink-muted flex items-start gap-3 text-sm">
            <input
              type="checkbox"
              name="sms_consent"
              value="yes"
              class="border-line-base mt-1 size-4 rounded"
            />
            <span>
              By sharing your phone number, you consent to receive communications from Platte River
              Orthodontics, including notifications and appointment reminders. Message and data
              rates may apply. Text STOP to unsubscribe.
            </span>
          </label>

          <FormMessage />

          <Button type="submit" size="lg" class="w-full">Submit Request</Button>
        </form>
      </div>
    </div>
  </Container>
</Section>

<script>
  import { bindOutboundConversions } from '../../lib/track';

  bindOutboundConversions();
</script>
