---
/** Shared heading cluster so every block introduces itself the same way. */
import Heading from '../ui/Heading.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  level?: 2 | 3;
  centered?: boolean;
  /** Light type for navy and inverse bands. */
  inverse?: boolean;
}

const { eyebrow, title, body, level = 2, centered = false, inverse = false } = Astro.props;
---

{
  (eyebrow || title || body) && (
    <div class:list={['flex w-full flex-col gap-3', centered && 'items-center text-center']}>
      {eyebrow && (
        <p
          class:list={[
            'text-sm font-semibold tracking-wide uppercase',
            inverse ? 'text-white/70' : 'text-ink-brand',
          ]}
        >
          {eyebrow}
        </p>
      )}
      {title && <Heading level={level} class={inverse ? 'text-ink-inverse' : undefined}>{title}</Heading>}
      {body && (
        <p class:list={['max-w-reading text-lg', inverse ? 'text-white/75' : 'text-ink-muted']}>{body}</p>
      )}
    </div>
  )
}
