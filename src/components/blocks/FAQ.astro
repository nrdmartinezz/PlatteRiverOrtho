---
/**
 * Native <details> accordion — no JS, keyboard-operable for free.
 * Emits FAQPage structured data unless `schema` is disabled.
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import BlockHeader from './BlockHeader.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps, BlockAction } from './types';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props extends BlockProps {
  items: FaqItem[];
  schema?: boolean;
  /** Allows several answers open at once. */
  multiple?: boolean;
  layout?: 'stack' | 'split';
  action?: BlockAction;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  items,
  schema = true,
  multiple = false,
  layout = 'stack',
  action,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Section background={background} spacing={spacing}>
  <Container
    width={layout === 'split' ? width : 'narrow'}
    layout={layout === 'split' ? 'row' : 'stack'}
    align={align}
    gap="lg"
    class={layout === 'split' ? 'md:items-start' : undefined}
  >
    <div class:list={[layout === 'split' && 'flex flex-col items-start gap-5 md:w-2/5']}>
      <BlockHeader
        eyebrow={eyebrow}
        title={title}
        body={body}
        level={titleLevel}
        centered={layout === 'stack' && align === 'center'}
      />
      {
        action && (
          <Button href={action.href} variant={action.variant ?? 'primary'}>
            {action.label}
          </Button>
        )
      }
    </div>

    <div class:list={['w-full', layout === 'split' && 'md:w-3/5']}>
      {
        items.map((item) => (
          <details name={multiple ? undefined : 'faq'} class="border-line-base group border-b">
            <summary class="font-heading flex min-h-14 cursor-pointer items-center justify-between gap-4 py-3 font-medium">
              {item.question}
              <Icon
                name="lucide:plus"
                class="size-5 shrink-0 transition-transform group-open:rotate-45"
                aria-hidden="true"
              />
            </summary>
            <p class="text-ink-muted max-w-reading pb-4">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </Container>
</Section>

{schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  summary {
    list-style: none;
  }
</style>
