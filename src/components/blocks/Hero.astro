---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps, BlockAction } from './types';

export interface HeroHighlight {
  icon: string;
  label: string;
}

interface Props extends Omit<BlockProps, 'titleLevel' | 'body'> {
  title: string;
  /** Second headline line — script + mint on overlay heroes. */
  titleAccent?: string;
  body?: string | string[];
  actions?: BlockAction[];
  image?: ImageMetadata;
  imageAlt?: string;
  /**
   * YouTube video id, played muted and looping behind an overlay hero.
   * The image stays visible before playback and when motion is reduced.
   */
  videoId?: string;
  /** Accessible name for the background video. */
  videoTitle?: string;
  /** Places the image first on desktop; small screens always stack image-first. */
  reverse?: boolean;
  bullets?: string[];
  highlights?: HeroHighlight[];
  /**
   * Full-bleed hero that tucks under the header so the nav can sit over it.
   * Pair with `overlay` on BaseLayout.
   */
  overlay?: boolean;
}

const {
  background = 'muted',
  spacing = 'lg',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  titleAccent,
  body,
  actions = [],
  image,
  imageAlt = '',
  videoId,
  videoTitle = 'Platte River Orthodontics',
  reverse = false,
  bullets = [],
  highlights = [],
  overlay = false,
} = Astro.props;

const splitImage = Boolean(image) && !overlay;
const paragraphs = body ? (Array.isArray(body) ? body : [body]) : [];
const youtubeId = videoId && /^[\w-]{6,}$/.test(videoId) ? videoId : undefined;
const videoSrc = youtubeId
  ? `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&mute=1&controls=0&rel=0&playsinline=1&loop=1&playlist=${youtubeId}&modestbranding=1&disablekb=1&fs=0&iv_load_policy=3&cc_load_policy=0`
  : undefined;
---

<Section
  background={overlay ? 'inverse' : background}
  spacing={overlay ? 'none' : spacing}
  data-hero-overlay={overlay ? '' : undefined}
  class:list={[overlay && 'hero-overlay relative isolate overflow-hidden']}
>
  {
    overlay && image && (
      <div class="absolute inset-0 -z-10">
        <Image
          src={image}
          alt={imageAlt}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover object-[68%_center] max-md:object-center"
        />
        {videoSrc && (
          <div class="hero-video absolute inset-0" aria-hidden="true">
            <iframe
              src={videoSrc}
              title={videoTitle}
              allow="autoplay; encrypted-media; picture-in-picture"
              referrerpolicy="strict-origin-when-cross-origin"
              tabindex="-1"
            />
          </div>
        )}
        <div class="from-brand-100 via-brand-200/90 to-brand-400/20 max-md:from-brand-100/95 max-md:via-brand-200/88 max-md:to-brand-200/70 absolute inset-0 bg-linear-to-r from-8% via-42% to-78%" />
        <div class="from-brand-100/45 to-brand-100/25 absolute inset-0 bg-linear-to-t via-transparent" />
      </div>
    )
  }

  <Container
    width={width}
    layout={splitImage ? 'row' : 'stack'}
    align={align}
    gap="lg"
    class:list={[overlay && 'relative z-10']}
  >
    <div
      class:list={[
        'flex flex-col items-start',
        overlay ? 'max-w-xl gap-7 lg:max-w-2xl' : 'gap-6',
        splitImage && 'md:w-1/2',
        reverse && splitImage && 'md:order-2',
      ]}
    >
      {
        eyebrow && (
          <p
            class:list={[
              'text-sm font-semibold tracking-wide uppercase',
              overlay ? 'text-ink-inverse/80' : 'text-ink-brand',
            ]}
          >
            {eyebrow}
          </p>
        )
      }

      <Heading level={1} balance={!titleAccent} class:list={[overlay && 'text-ink-inverse']}>
        {title}
        {
          titleAccent && (
            <span class="font-heading text-accent-200 mt-1 block text-[1.05em] leading-none font-semibold tracking-tight italic">
              {titleAccent}
            </span>
          )
        }
      </Heading>

      {
        paragraphs.length > 0 && (
          <div
            class:list={[
              'max-w-reading flex flex-col gap-4',
              overlay ? 'text-base opacity-90' : 'text-lg opacity-90',
            ]}
          >
            {paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )
      }

      {
        !overlay && bullets.length > 0 && (
          <ul class="flex flex-col gap-2">
            {bullets.map((bullet) => (
              <li class="flex items-start gap-3">
                <Icon
                  name="lucide:check"
                  class="mt-1 size-5 shrink-0 opacity-80"
                  aria-hidden="true"
                />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        overlay && actions.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
            {actions.map((action) => {
              const isPrimary = !action.variant || action.variant === 'primary';
              return isPrimary ? (
                <a
                  href={action.href}
                  class="text-ink-inverse inline-flex min-h-11 items-center gap-2 text-xs font-semibold tracking-wide uppercase no-underline hover:opacity-80"
                >
                  {action.label}
                  <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
                </a>
              ) : (
                <a
                  href={action.href}
                  class="text-ink-inverse inline-flex min-h-11 items-center rounded-full border border-white/80 px-6 text-xs font-semibold tracking-wide uppercase no-underline hover:bg-white/10"
                >
                  {action.label}
                </a>
              );
            })}
          </div>
        )
      }

      {
        !overlay && actions.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {actions.map((action) => (
              <Button href={action.href} variant={action.variant ?? 'primary'} size="lg">
                {action.label}
              </Button>
            ))}
          </div>
        )
      }

      {
        overlay && highlights.length > 0 && (
          <ul class="flex flex-wrap items-center gap-x-8 gap-y-3">
            {highlights.map((item) => (
              <li class="flex items-center gap-2.5 text-sm">
                <Icon name={item.icon} class="text-accent-200 size-4 shrink-0" aria-hidden="true" />
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      splitImage && image && (
        <div class:list={['w-full md:w-1/2', reverse && 'md:order-1']}>
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 768, 1024]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="eager"
            fetchpriority="high"
            class="w-full rounded-lg object-cover"
          />
        </div>
      )
    }
  </Container>
</Section>

<style>
  .hero-overlay {
    margin-top: calc((var(--topbar-h, 2.75rem) + var(--nav-h, 5rem)) * -1);
    padding-top: calc(var(--topbar-h, 2.75rem) + var(--nav-h, 5rem) + var(--spacing-section-lg));
    padding-bottom: var(--spacing-section-lg);
    min-height: min(44rem, 92svh);
    display: flex;
    align-items: center;
    background:
      linear-gradient(
        90deg,
        var(--color-brand-100) 10%,
        color-mix(in srgb, var(--color-brand-200) 88%, transparent) 40%,
        transparent 78%
      ),
      linear-gradient(160deg, var(--color-brand-200), var(--color-brand-100));
  }

  .hero-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    container-type: size;
  }

  .hero-video iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, calc(100cqh * 16 / 9));
    height: max(100cqh, calc(100cqw * 9 / 16));
    transform: translate(-50%, -50%);
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
</style>
