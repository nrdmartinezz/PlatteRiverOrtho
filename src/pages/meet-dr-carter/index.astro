---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/blocks/Hero.astro';
import FeatureSplit from '../../components/blocks/FeatureSplit.astro';
import BenefitsGrid from '../../components/blocks/BenefitsGrid.astro';
import WhySplit from '../../components/blocks/WhySplit.astro';
import CTABanner from '../../components/blocks/CTABanner.astro';
import FAQ from '../../components/blocks/FAQ.astro';
import VisitUs from '../../components/blocks/VisitUs.astro';
import ContactBlock from '../../components/blocks/ContactBlock.astro';
import drCarter from '../../assets/team/dr-carter.jpg';
import familyPractice from '../../assets/live/family-practice-platte-river-ortho-1.png';
import burkina1 from '../../assets/live/20251126-Burkina-Dental-Picture1.jpg';
import amyCarter from '../../assets/live/platte-river-orthodontics-gretna-ne-amy-carter.jpg';
import treatmentChair from '../../assets/live/platte-river-ortho-treatment-chair.jpg';
import quoteBand from '../../assets/quote-band.jpg';

const faqs = [
  {
    question: 'What kind of doctor is Dr. Chad Carter?',
    answer:
      'He is a board-certified orthodontist and dentofacial orthopedist. American Board of Orthodontics certification is a voluntary step after residency: a written exam and a review of finished cases. He is also an Associate Professor and an international lecturer on craniofacial growth.',
  },
  {
    question: 'Does Dr. Carter see children as well as adults?',
    answer:
      'Yes. He plans care for a child in early treatment, a teen in braces, or an adult ready for a change. The first visit is complimentary.',
  },
  {
    question: 'What treatment options can I ask about?',
    answer:
      'You can ask about Invisalign clear aligners, KLOwen custom braces, Wild Smiles for kids, early treatment, and surgical orthodontics coordinated with an oral surgeon. The consultation shows which options fit.',
  },
  {
    question: 'Does Dr. Carter speak my language?',
    answer:
      'He uses more than one language in the office each week, including languages he learned during seven years in West Africa. Call 402-322-8838 to ask whether the team can communicate in the language you prefer.',
  },
  {
    question: 'Where is Platte River Orthodontics?',
    answer:
      'The office is at 11844 Standing Stone Dr, Suite 100, Gretna, NE 68028. The clinic is open Monday–Thursday, 8:00 am–5:00 pm, and Saturday, 9:00 am–3:00 pm. Calls are answered Monday–Friday, 7am–7pm.',
  },
];
---

<BaseLayout
  overlay
  titleExact
  title="Meet Dr. Carter | Platte River Orthodontics | Gretna, NE"
  description="Meet Dr. Chad B. Carter, a board-certified orthodontist in Gretna, NE. See what that certification means for your family. Call 402-322-8838."
  image={familyPractice.src}
  faqs={faqs}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Meet Dr. Carter', href: '/meet-dr-carter/' },
  ]}
>
  <Hero
    overlay
    eyebrow="Platte River Orthodontics | Gretna, NE"
    title="Meet Dr. Chad B. Carter"
    titleAccent="Board-certified orthodontist"
    body="Families here get expert care, answers in plain language, and a plan made for their child, teen, or adult. The path below is why that care is trustworthy."
    image={familyPractice}
    imageAlt="The Platte River Orthodontics team in Gretna"
    actions={[
      { label: 'Request a Consultation', href: '/request-appointment/' },
      { label: 'Call 402-322-8838', href: 'tel:+14023228838', variant: 'secondary' },
    ]}
  />

  <FeatureSplit
    reverse
    eyebrow="Meet Your Orthodontist"
    subtitle="Board-certified orthodontist. Veteran. Teacher. Father."
    title="What board certification means"
    body={[
      'After dental school and an orthodontic residency, American Board of Orthodontics certification is a voluntary extra step: a written exam and a review of finished cases. It is an outside check on Dr. Carter’s knowledge and results. That matters when a child’s growth or bite is more than simple straightening.',
      'He explains what he finds, answers questions directly, and builds the plan around that patient. The office is welcoming, and he is easy to talk with.',
    ]}
    image={drCarter}
    imageAlt="Dr. Chad B. Carter, board-certified orthodontist at Platte River Orthodontics"
    callout={{
      title: "Dr. Carter's Experience",
      items: [
        'Board-certified by the American Board of Orthodontics',
        'U.S. Air Force veteran',
        'Associate Professor and international lecturer on craniofacial growth',
        'Consultant to the Boys Town National Research Hospital Craniofacial Team',
        'Seven years of service in West Africa before dentistry',
      ],
    }}
    badge={{ value: 'ABO', label: 'Board Certified' }}
    actions={[
      { label: 'Request a Consultation', href: '/request-appointment/' },
      { label: 'Explore MARPE Care', href: '/services/marpe/', variant: 'secondary' },
    ]}
  />

  <FeatureSplit
    background="muted"
    eyebrow="A Foundation in Scientific Excellence"
    title="From Physics to Careful Planning"
    body="Dr. Carter’s training began in physics research. That foundation still shapes how he plans treatment: precise, methodical, and grounded in evidence. The same problem-solving shows up when a case involves growth, the bite, or the jaws."
    image={burkina1}
    imageAlt="Dr. Carter during his years of service in Burkina Faso"
    bullets={[
      'Precision and methodology from a physics research background',
      'Evidence-based planning for even the most complex cases',
      'A problem-solving mindset that patients and referring doctors can trust',
    ]}
  />

  <BenefitsGrid
    layout="grid"
    eyebrow="Seven Years in West Africa"
    title="Service that still shapes the visit"
    body="Dr. Carter and Amy spent seven years as volunteers in a rural village on the edge of the Sahara in Burkina Faso. It was a full life there, not a short trip, and it taught him to meet people where they are. Their partnership with ministries in West Africa has continued for more than twenty-five years. Patients still hear that care as clear explanations, patience, and respect."
    items={[
      {
        icon: 'lucide:languages',
        title: 'Language and Communication',
        body: 'In Africa, Dr. Carter learned to communicate across cultural and linguistic barriers. He still speaks multiple languages weekly in practice, meeting patients where they are.',
      },
      {
        icon: 'lucide:handshake',
        title: 'Building Relationships Across Cultures',
        body: 'One favorite story: greeting a West African woman in a Gretna Hy-Vee in her native language — a reminder that connection can happen anywhere.',
      },
      {
        icon: 'lucide:smile',
        title: 'A Smile Is Universal',
        body: 'He learned that healthcare is not only technical expertise. It is understanding people, offering dignity and respect, and knowing that a smile builds trust across every barrier.',
      },
    ]}
  />

  <WhySplit
    eyebrow="Family"
    title="Amy Carter: Partner in Life and Mission"
    body="Dr. Carter’s wife, Amy, has been with him through their 25-year journey — from their years in West Africa to military life and building Platte River Orthodontics. A school teacher who also homeschooled their two sons while moving with the Air Force, Amy keeps family time at the center of the practice. Those values show up as appointments that respect school and work. Friends sometimes call him SnaggleTooth. That nickname stays in the background. The visit is a clinical conversation with someone who takes the time to explain the plan."
    items={[
      'Family perspective: understanding the needs and concerns of parents',
      'Cultural sensitivity from living and working in diverse communities',
      'Community connection: building relationships here in Gretna',
      'Practice support that keeps the office warm and family-friendly',
      'Mission partnership: sharing the vision and values that guide the practice',
    ]}
    asideEyebrow="A Practice Built for Families"
    asideTitle="Care that respects your time"
    asideBody="Amy’s experience as a parent, military spouse, and community member helps ensure Platte River Orthodontics serves families at every level — with Monday–Thursday and Saturday clinic hours, a phone line answered Monday–Friday 7am–7pm, and the same hospitality Dr. Carter is known for."
    image={amyCarter}
    imageAlt="Amy Carter"
  />

  <FAQ
    layout="split"
    eyebrow="Common Questions"
    title="Frequently Asked Questions"
    body="Have more questions? Call 402-322-8838 or request a complimentary consultation."
    action={{ label: 'Request a Consultation', href: '/request-appointment/' }}
    items={faqs}
    schema={false}
  />

  <CTABanner
    eyebrow="Platte River Orthodontics — Gretna, NE"
    title="Ready to Start Your Journey to a More Confident Smile?"
    body="Your new smile is just a consultation away. We will answer your questions, walk through treatment options, and help you take the first step — with no pressure and no commitment."
    image={quoteBand}
    imageAlt=""
    actions={[
      { label: 'Request a Consultation', href: '/request-appointment/' },
      { label: 'Call 402-322-8838', href: 'tel:+14023228838', variant: 'secondary' },
    ]}
  />

  <VisitUs
    image={treatmentChair}
    paragraphs={[
      'Come meet Dr. Carter at our Gretna office. Your first visit is complimentary — a chance to talk through your goals and see whether we are the right fit.',
    ]}
    cta={{ label: 'Request a Consultation', href: '/request-appointment/' }}
  />

  <ContactBlock />
</BaseLayout>
