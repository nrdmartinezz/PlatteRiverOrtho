---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import Stats from '../components/blocks/Stats.astro';
import BenefitsGrid from '../components/blocks/BenefitsGrid.astro';
import FeatureSplit from '../components/blocks/FeatureSplit.astro';
import TreatmentCards from '../components/blocks/TreatmentCards.astro';
import ProcessSteps from '../components/blocks/ProcessSteps.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import CTABanner from '../components/blocks/CTABanner.astro';
import FAQ from '../components/blocks/FAQ.astro';
import VisitUs from '../components/blocks/VisitUs.astro';
import ContactBlock from '../components/blocks/ContactBlock.astro';
import GoogleReviews from '../components/blocks/GoogleReviews.astro';
import drCarter from '../assets/team/dr-carter.jpg';
import treatmentChair from '../assets/live/platte-river-ortho-treatment-chair.jpg';
import officeDetail from '../assets/live/IMG_2725-2.jpg';
import invisalign from '../assets/live/gretna-ne-orthodontist-invisalign-platte-river-orthodontics.jpg';
import braces from '../assets/live/braces-gretna-ne-platte-river-orthodontics.jpg';
import jawSurgery from '../assets/live/platte-river-orthodontics-gretna-ne-surgical-orthodontics.jpg';
import quoteBand from '../assets/quote-band.jpg';

const faqs = [
  {
    question: 'When should my child first visit the orthodontist?',
    answer:
      'The American Association of Orthodontists recommends that children have their first orthodontic checkup by age seven. Early visits help us catch and correct problems while they are still easy to fix.',
  },
  {
    question: 'How long does Invisalign treatment usually take?',
    answer:
      'Treatment time depends on your smile goals and how consistently trays are worn. Many patients finish in 12 to 18 months. Dr. Carter will give you a personalized timeline at your complimentary consult.',
  },
  {
    question: 'Do you treat adults too?',
    answer:
      'Yes. A large share of our patients are adults. We offer discreet options like Invisalign and fully custom braces so treatment can fit work, family, and social life.',
  },
  {
    question: 'How do I know whether Invisalign or braces are right for me?',
    answer:
      'Both are available. Invisalign uses clear removable trays, and fully custom braces are designed for your teeth. Dr. Carter explains which option fits your bite and your routine at a complimentary consultation.',
  },
  {
    question: 'Can a consultation be virtual?',
    answer:
      'Yes. You can start with a virtual consult, then come into the Gretna office for records and digital scanning when you are ready to move forward. Call 402-322-8838 or request a time online.',
  },
  {
    question: 'Is MARPE treatment only for adults?',
    answer:
      'MARPE is typically recommended for older teens and adults whose midpalatal suture has matured. Younger children usually benefit from traditional or Invisalign First expanders. Dr. Carter will confirm the right option with 3D imaging.',
  },
  {
    question: 'Do you accept insurance and offer payment plans?',
    answer:
      'Yes. We work with most major insurance plans and offer flexible payment and financing options. Your complimentary consultation includes a clear cost breakdown with no surprises.',
  },
  {
    question: 'What areas do you serve?',
    answer:
      'Our office is in Gretna, Nebraska, and we welcome families from Omaha, Papillion, and the surrounding communities.',
  },
];
---

<BaseLayout
  overlay
  titleExact
  title="Platte River Orthodontics | Orthodontist in Gretna, NE"
  description="Board-certified orthodontic care for children, teens, and adults in Gretna, NE. Dr. Carter explains the plan in plain language. Call 402-322-8838."
  image={treatmentChair.src}
  faqs={faqs}
>
  <Hero
    overlay
    eyebrow="Orthodontist in Gretna, Nebraska"
    title="Expert Orthodontic Care."
    titleMiddle="A Personal Integrated Approach."
    titleAccent="Confidence for Life."
    body="Exceptional orthodontic care for children, teens, and adults in Gretna, Nebraska. Get a treatment plan tailored to your needs, clear answers to your questions, and a team that treats you like family."
    image={treatmentChair}
    imageAlt="A treatment room at Platte River Orthodontics in Gretna"
    videoId="NS_gJJ2On0k"
    videoTitle="The Platte River Orthodontics team in Gretna"
    actions={[
      { label: 'Request a Consultation', href: '/request-appointment/' },
      { label: 'Explore Services', href: '#services', variant: 'secondary' },
    ]}
    highlights={[
      { icon: 'lucide:award', label: 'Board-Certified' },
      { icon: 'lucide:house', label: 'Family-Owned' },
      { icon: 'lucide:users', label: 'Complimentary Consults' },
    ]}
  />

  <Stats
    compact
    background="muted"
    items={[
      { value: '10+', label: 'Years of Experience' },
      { value: 'Complimentary', label: 'Consultations' },
      { value: '5★', label: 'Patient Reviews' },
      { value: '8am–5pm', label: 'Mon–Thu Clinic' },
    ]}
  />

  <BenefitsGrid
    layout="grid"
    eyebrow="Why Families Choose Us"
    title="Why families choose Platte River Orthodontics"
    body="Board-certified orthodontic expertise. Personalized treatment. Straightforward communication. Convenient care. A local family-owned practice with a mission beyond the office. Gretna’s full-time orthodontic practice."
    items={[
      {
        featured: true,
        icon: 'lucide:award',
        title: 'Board-certified orthodontic expertise',
        body: 'After dental school and an orthodontic residency, American Board of Orthodontics certification is a voluntary extra step: a written exam and a review of finished cases. It is an outside check on knowledge and results, which matters when a child’s growth or bite is more than simple straightening.',
        href: '/meet-dr-carter/',
        cta: 'Meet Dr. Carter',
      },
      {
        icon: 'lucide:user-round',
        title: 'Personalized treatment',
        body: 'A plan built for that child, teen, or adult. Digital imaging helps Dr. Carter see the bite clearly and shape treatment around it.',
      },
      {
        icon: 'lucide:message-circle',
        title: 'Straightforward communication',
        body: 'Dr. Carter explains findings and options in plain language, so a family can decide without a sales pitch.',
      },
      {
        icon: 'lucide:clock',
        title: 'Convenient care',
        body: 'Flexible financing, virtual consults, clinic hours Monday–Thursday 8am–5pm and Saturday 9am–3pm, and calls answered Monday–Friday 7am–7pm.',
      },
      {
        icon: 'lucide:heart',
        title: 'A local family-owned practice',
        body: 'Dr. Carter and his family own the practice. The same commitment to service continues beyond the office, including a long partnership with projects in West Africa.',
      },
      {
        icon: 'lucide:map-pin',
        title: 'Gretna’s full-time orthodontic practice',
        body: 'This Gretna office is the practice, open full time for families from Gretna, Omaha, Papillion, and nearby communities.',
      },
    ]}
  />

  <FeatureSplit
    id="meet-dr-carter"
    reverse
    eyebrow="Meet Your Orthodontist"
    subtitle="Board-certified orthodontist. Veteran. Teacher. Father."
    title="Meet Dr. Chad Carter"
    body={[
      'Dr. Chad B. Carter is a board-certified orthodontist. He explains what he sees, answers questions directly, and builds a treatment plan for that patient — a child in early treatment, a teen in braces, or an adult ready for a change.',
      'He is easy to talk with, and the office treats patients like family.',
    ]}
    image={drCarter}
    imageAlt="Dr. Chad B. Carter, board-certified orthodontist at Platte River Orthodontics"
    callout={{
      title: "Dr. Carter's Experience",
      items: [
        'Board-certified by the American Board of Orthodontics',
        'U.S. Air Force veteran',
        'Associate Professor and international lecturer on craniofacial growth',
        'Consultant to the Boys Town National Research Hospital Craniofacial Team',
        'Seven years of service in West Africa before dentistry',
      ],
    }}
    badge={{ value: 'ABO', label: 'Board Certified' }}
    actions={[
      { label: 'Learn More About Dr. Carter', href: '/meet-dr-carter/' },
      { label: 'Request a Consultation', href: '/request-appointment/', variant: 'secondary' },
    ]}
  />

  <TreatmentCards
    eyebrow="What We Do"
    title="Services We Offer"
    intro="Every treatment is a plan Dr. Carter builds for that patient. Digital imaging helps him see the bite clearly and explain the options."
    items={[
      {
        image: invisalign,
        imageAlt: 'Invisalign clear aligners and case',
        title: 'Invisalign® Clear Aligners',
        body: 'Invisalign® offers a discreet, comfortable way to straighten teeth using nearly invisible trays — no brackets, no wires, no lifestyle disruptions. Custom-tailored for efficient, predictable results.',
        href: '/invisalign/',
        cta: 'Learn More about Invisalign',
      },
      {
        image: braces,
        imageAlt: 'Custom ceramic braces on a dental model',
        title: 'Fully Custom Braces',
        body: "Dr. Carter uses fully custom braces designed just for you — using advanced 3D technology for a personalized treatment plan that's more efficient and comfortable than traditional braces.",
        href: '/braces/',
        cta: 'See Our Braces Options',
      },
      {
        image: jawSurgery,
        imageAlt: 'The Platte River Orthodontics clinical team',
        title: 'Corrective Jaw Surgery',
        body: 'This life-changing treatment improves your ability to chew, speak, and breathe while enhancing facial aesthetics. Ideal for underbites, overbites, open bites, facial asymmetry, or sleep apnea.',
        href: '/surgical-orthodontics/',
        cta: 'Learn About Surgical Care',
      },
    ]}
  />

  <ProcessSteps
    background="muted"
    align="center"
    eyebrow="Simple Process"
    title="Your Path to a Confident Smile"
    body="Getting started is a conversation, not a commitment. Here is what to expect."
    items={[
      {
        title: 'Request a Consultation',
        body: 'Schedule online or call 402-322-8838. The first visit is complimentary, with time for your questions.',
      },
      {
        title: 'Hear the Plan in Plain Language',
        body: 'Dr. Carter examines the bite, uses digital imaging where it helps, and explains a plan tailored to that child, teen, or adult.',
      },
      {
        title: 'Start Treatment with a Team You Know',
        body: 'Begin care in a welcoming office, with scheduling that respects school and work.',
      },
    ]}
  />

  <GoogleReviews />

  <Testimonials
    eyebrow="Patient Stories"
    title="Patient Testimonials"
    columns={2}
    ratingSummary={{ score: '5.0', label: 'Based on Google Reviews' }}
    items={[
      {
        quote:
          'After having my teeth shift many years post-braces, Dr. Carter was able to get me set up with Invisalign. The treatment has been so comfortable, easy, and has given me results that have boosted my confidence. Thank you, team, you’re the best!',
        name: 'Lina',
        role: 'Google Review',
        rating: 5,
      },
      {
        quote:
          'Dr. Carter and his team were excellent! They are very easy to talk with, worked with us through any concerns we had, made sure we understood the treatment plan, and provided the best care. They ensured my daughter was comfortable at every appointment. I just can’t say enough good about the care we received.',
        name: 'Patient',
        role: 'Google Review',
        rating: 5,
      },
      {
        quote:
          'Dr Carter came into my life when I was dealing with the worst dental trauma I could have imagined. He and his team not only fixed my teeth and brought my smile back, but they also made me feel like family during the months-long treatment. You would be hard pressed to find a better orthodontist!',
        name: 'Chris',
        role: 'Google Review',
        rating: 5,
      },
      {
        quote:
          'As an adult in braces, I was concerned about how it might affect my confidence, but with Dr. Carter, I left each appointment feeling more confident. They helped educate me on what was going on with each step of treatment. It’s thanks to them that I wake up and smile more every day.',
        name: 'Patient',
        role: 'Google Review',
        rating: 5,
      },
    ]}
  />

  <CTABanner
    eyebrow="Limited New Patient Spots"
    title="Expert care, clear answers, and an office that treats you like family."
    body="Board-certified orthodontic care for children, teens, and adults in Gretna. Dr. Carter explains the plan, and the team is here for every visit."
    image={quoteBand}
    imageAlt=""
    actions={[
      { label: 'Request a Consultation', href: '/request-appointment/' },
      { label: 'Call 402-322-8838', href: 'tel:+14023228838', variant: 'secondary' },
    ]}
  />

  <FAQ
    layout="split"
    eyebrow="Common Questions"
    title="Frequently Asked Questions"
    body="Have more questions? We're happy to help. Call us at 402-322-8838 or request your complimentary consultation online."
    action={{ label: 'Request a Consultation', href: '/request-appointment/' }}
    items={faqs}
    schema={false}
  />

  <VisitUs
    image={officeDetail}
    paragraphs={[
      'The Standing Stone Drive office is built around comfort and a visit that respects your time.',
      'From advanced digital imaging and modern treatment bays to flexible scheduling and a warm, welcoming atmosphere, everything about our office is built to make you feel at ease.',
    ]}
  />

  <ContactBlock />
</BaseLayout>
